{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "A crypto blog article",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "image_url": { "type": "string" },
        "source_url": { "type": "string" },
        "keywords": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "views": { "type": "number" },
        "published_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "summary", "content", "category"]
    },
    "Setting": {
      "title": "Setting",
      "description": "App settings",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["key", "value"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "Blog articles"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "App settings"
    }
  }
}
