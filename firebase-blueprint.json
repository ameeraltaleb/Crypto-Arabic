{
  "entities": {
    "Job": {
      "title": "Job",
      "description": "A job posting",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "slug": { "type": "string" },
        "datePosted": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["title", "company", "location", "type", "description", "slug"]
    }
  },
  "firestore": {
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Job postings"
    }
  }
}
