rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Allow public read access to jobs for SEO and general users
    match /jobs/{jobId} {
      allow read: if true;
      // Allow creation of jobs from the frontend, but prevent modifications or deletions
      allow create: if request.resource.data.keys().hasAll(['title', 'company', 'location', 'type', 'description'])
                    && request.resource.data.title is string
                    && request.resource.data.description is string;
      allow update, delete: if false; // Only admin (via Firebase Console or Admin SDK) can update/delete
    }
  }
}
